# usersAppAK — environment variables (copy to .env or to your server environment).
PORT=8080
# Extra allowed browser origins, comma separated (local/LAN ones are already allowed).
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://store.yourdomain.com
# ALLOW_ANY_ORIGIN=1          # dev only

# AI agent
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_MAX_TOKENS=

# Firebase admin credentials (change password / email)
FIREBASE_CREDENTIALS_FILE=./your-firebase-adminsdk.json

# Support requests (POST /supportrequests): where they are emailed + SMTP to send them
SUPPORT_EMAIL_TO=support@yourdomain.com
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com

# Cookie domain: today used only by logout (login has it commented out) — see shao/DEPLOY_README.md
# AUTH_COOKIE_DOMAIN=.yourdomain.com
